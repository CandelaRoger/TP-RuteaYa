
@model List<RuteaYa.DTOs.OportunidadDto>

@{
    ViewData["Title"] = "Mis envíos asignados";
}

<div class="container mt-4">

    <h2>Mis envíos asignados</h2>

    <p class="text-muted">
        Paquetes asignados al viaje #@ViewBag.ViajeId
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Todavía no tenés paquetes asignados a este viaje.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var envio in Model)
            {
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h5 class="card-title">
                                @envio.OrigenDir
                                →
                                @envio.DestinoDir
                            </h5>

                            <p>
                                <strong>Descripción:</strong>
                                @envio.Descripcion
                            </p>

                            <p>
                                <strong>Fecha:</strong>
                                @envio.Fecha.ToString("dd/MM/yyyy")
                            </p>

                            <p>
                                <strong>Peso:</strong>
                                @envio.Peso kg
                            </p>

                            <p>
                                <strong>Tamaño:</strong>
                                @envio.Tamanio
                            </p>

                            <p class="text-success fw-bold">
                                Monto ofrecido:
                                @envio.MontoOfrecido.ToString("C")
                            </p>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <a asp-controller="Viajes"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Volver a mis viajes
    </a>

</div>
