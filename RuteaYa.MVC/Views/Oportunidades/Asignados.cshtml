
@model List<RuteaYa.DTOs.OportunidadDto>
@{
    var capacidad = ViewBag.Capacidad as RuteaYa.DTOs.CapacidadViajeDto;
}
@{
    ViewData["Title"] = "Mis envíos asignados";
}

<div class="container mt-4">

    <h2>Mis envíos asignados</h2>
    
@if (capacidad != null)
{
    var porcentajePaquetes = capacidad.MaxPaquetes > 0
        ? Math.Clamp(
            capacidad.PaquetesOcupados * 100.0
            / capacidad.MaxPaquetes, 0, 100)
        : 0;

    var porcentajePeso = capacidad.PesoMaxKg > 0
        ? Math.Clamp(
            (double)(capacidad.PesoOcupadoKg * 100
            / capacidad.PesoMaxKg), 0, 100)
        : 0;

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5>Capacidad del viaje</h5>

            <div class="d-flex justify-content-between mt-3">
                <strong>Paquetes asignados</strong>
                <span>
                    @capacidad.PaquetesOcupados /
                    @capacidad.MaxPaquetes
                </span>
            </div>

            <div class="progress mb-3">
                <div class="progress-bar bg-success"
                     style="width: @(porcentajePaquetes.ToString(System.Globalization.CultureInfo.InvariantCulture))%">
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <strong>Peso ocupado</strong>
                <span>
                    @capacidad.PesoOcupadoKg /
                    @capacidad.PesoMaxKg kg
                </span>
            </div>

            <div class="progress mb-3">
                <div class="progress-bar bg-primary"
                     style="width: @(porcentajePeso.ToString(System.Globalization.CultureInfo.InvariantCulture))%">
                </div>
            </div>

            <div class="alert alert-info">
                <strong>Disponible:</strong>
                @capacidad.PaquetesDisponibles paquetes
                y @capacidad.PesoDisponibleKg kg
            </div>

        </div>
    </div>
}

    <p class="text-muted">
        Paquetes asignados al viaje #@ViewBag.ViajeId
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Todavía no tenés paquetes asignados a este viaje.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var envio in Model)
            {
                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">

                            <h5 class="card-title">
                                @envio.OrigenDir
                                →
                                @envio.DestinoDir
                            </h5>

                            <p>
                                <strong>Descripción:</strong>
                                @envio.Descripcion
                            </p>

                            <p>
                                <strong>Fecha:</strong>
                                @envio.Fecha.ToString("dd/MM/yyyy")
                            </p>

                            <p>
                                <strong>Peso:</strong>
                                @envio.Peso kg
                            </p>

                            <p>
                                <strong>Tamaño:</strong>
                                @envio.Tamanio
                            </p>

                            <p class="text-success fw-bold">
                                Monto ofrecido:
                                @envio.MontoOfrecido.ToString("C")
                            </p>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <a asp-controller="Viajes"
       asp-action="Index"
       class="btn btn-outline-secondary mt-3">
        Volver a mis viajes
    </a>

</div>
