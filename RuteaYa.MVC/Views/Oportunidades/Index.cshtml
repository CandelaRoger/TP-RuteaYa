@model List<RuteaYa.DTOs.OportunidadDto>

@{
    ViewData["Title"] = "Oportunidades";
}

<div class="container mt-4">

    <h2>Oportunidades disponibles</h2>

    <p class="text-muted">
        Envíos candidatos para el viaje #@ViewBag.ViajeId
    </p>

    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
        <span class="text-muted small">Ordenar por</span>
        @foreach (var (valor, texto) in new[] { ("ganancia", "Ganancia"), ("desvio", "Desvío"), ("compatibilidad", "Compatibilidad") })
        {
            <a asp-action="Index" asp-route-viajeId="@ViewBag.ViajeId" asp-route-orden="@valor"
               class="btn btn-sm @((string?)ViewBag.Orden == valor ? "btn-primary" : "btn-outline-secondary")">
                @texto
            </a>
        }
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            @TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No hay oportunidades disponibles para este viaje.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var oportunidad in Model)
            {
                var clase = oportunidad.Compatibilidad switch
                {
                    "Muy compatible" => "bg-success",
                    "Compatible" => "bg-primary",
                    _ => "bg-warning text-dark"
                };

                <div class="col-md-6 mb-3">
                    <div class="card shadow-sm">
                        
<div class="card-body p-4">

    <h5 class="card-title fw-bold mb-2">
        @oportunidad.OrigenDir
        <span class="text-primary">→</span>
        @oportunidad.DestinoDir
    </h5>

    <p class="text-muted small mb-3">
        @oportunidad.Descripcion ·
        @oportunidad.Fecha.ToString("dd/MM/yyyy")
    </p>

    <h6 class="fw-bold mb-3">
        Ruta habitual vs. con el envío
    </h6>
    <div class="d-flex justify-content-between border-bottom py-2">
    <span>Distancia habitual</span>
    <strong>@oportunidad.DistanciaHabitualKm.ToString("0.0") km</strong>
</div>

<div class="d-flex justify-content-between border-bottom py-2">
    <span>Distancia con el envío</span>
    <strong>@oportunidad.DistanciaConEnvioKm.ToString("0.0") km</strong>
</div>
    <div class="d-flex justify-content-between border-bottom py-2">
        <span>Desvío</span>
        <strong>
            +@oportunidad.DesvioKm.ToString("0.0") km
        </strong>
    </div>

   <div class="d-flex justify-content-between border-bottom py-2">
    <span>Tiempo habitual</span>
    <strong>@oportunidad.TiempoHabitualMin min</strong>
</div>

<div class="d-flex justify-content-between border-bottom py-2">
    <span>Tiempo adicional</span>
    <strong class="text-warning">
        +@oportunidad.TiempoAdicionalMin.ToString("0") min
    </strong>
</div>
    <div class="d-flex justify-content-between border-bottom py-2">
        <span>Peso</span>
        <strong>@oportunidad.Peso.ToString("0.##") kg</strong>
    </div>
    <div class="d-flex justify-content-between border-bottom py-2">
    <span>Capacidad restante al aceptar</span>
    <strong>
        @oportunidad.CapacidadRestanteKg.ToString("0.##") kg ·
        @oportunidad.PaquetesRestantes paquetes
    </strong>
</div>
    <div class="d-flex justify-content-between border-bottom py-2">
        <span>Tamaño</span>
        <strong>@oportunidad.Tamanio</strong>
    </div>

    <div class="d-flex justify-content-between align-items-center py-2">
        <span>Compatibilidad</span>
        <span class="badge @clase">
            @oportunidad.Compatibilidad
        </span>
    </div>

    <div class="bg-success bg-opacity-10 rounded-3 p-3 my-3">
        <div class="text-success small fw-semibold">
            Pago ofrecido
        </div>

        <div class="fs-3 fw-bold text-success">
            @oportunidad.MontoOfrecido.ToString("C")
        </div>

        @if (oportunidad.DesvioKm > 0)
        {
            <div class="small text-success">
                @((oportunidad.MontoOfrecido /
                    (decimal)oportunidad.DesvioKm).ToString("C"))
                por km adicional
            </div>
        }
    </div>

    <form asp-controller="Oportunidades"
          asp-action="Aceptar"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="viajeId"
               value="@ViewBag.ViajeId" />

        <input type="hidden"
               name="envioId"
               value="@oportunidad.EnvioId" />

        <button type="submit"
                class="btn btn-success w-100 rounded-3 py-2 fw-bold"
                onclick="return confirm('¿Querés aceptar este envío?');">
            Aceptar envío
        </button>
    </form>

</div>

                    </div>
                </div>
            }
        </div>
    }
</div>