@model RuteaYa.MVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
     Layout = "_LayoutAuth";
}

    <div class="container d-flex align-items-center justify-content-center min-vh-100">
        <div class="card shadow-lg border-0 rounded-4" style="max-width: 900px; width: 100%;">
            <div class="row g-0">
                <div class="col-md-6 d-none d-md-block bg-primary text-white rounded-start-4 p-5 d-flex flex-column justify-content-center">
                    <h1 class="display-5 fw-bold mb-4">Llevá paquetes. Ganá plata.</h1>
                    <p class="lead">Aprovechá tus recorridos diarios para transportar envíos. La plataforma colaborativa líder.</p>
                </div>
                <div class="col-md-6 p-5">
                    <h3 class="fw-bold text-center mb-4 text-primary">RuteaYa</h3>
                    <form asp-controller="Auth" asp-action="Login" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label text-muted"></label>
                            <input asp-for="Email" class="form-control form-control-lg bg-light border-0" />
                            <span asp-validation-for="Email" class="text-danger d-block mt-1 small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label text-muted"></label>
                            <input asp-for="Password" class="form-control form-control-lg bg-light border-0" />
                            <span asp-validation-for="Password" class="text-danger d-block mt-1 small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill">Iniciar Sesión</button>

                        <div class="text-center mt-4">
                            <span class="text-muted">¿Nuevo por acá?</span>
                            <a asp-controller="Auth" asp-action="Registro" class="text-decoration-none fw-bold">Registrarse</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
