@model RuteaYa.DTOs.EnvioDto

@{
    ViewData["Title"] = "Detalle del envío";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Detalle del envío</h2>
            <p class="text-muted mb-0">Toda la información del paquete publicado.</p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            Volver a mis envíos
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">

        <h5 class="fw-bold mb-3">Información del envío</h5>

        <div class="mb-3">
            <strong>Descripción:</strong>
            <p class="text-muted mb-0">@Model.Descripcion</p>
        </div>

        <hr />

        <h5 class="fw-bold mb-3">Recorrido</h5>

        <div class="mb-3">
            <strong>Origen:</strong>
            <p class="text-muted mb-0">@Model.OrigenDir</p>
        </div>

        <div class="mb-3">
            <strong>Destino:</strong>
            <p class="text-muted mb-0">@Model.DestinoDir</p>
        </div>

        <hr />

        <h5 class="fw-bold mb-3">Características del paquete</h5>

        <div class="row g-3">
            <div class="col-md-4">
                <strong>Peso:</strong>
                <p class="text-muted">@Model.Peso kg</p>
            </div>

            <div class="col-md-4">
                <strong>Tamaño:</strong>
                <p class="text-muted">@Model.Tamanio</p>
            </div>

            <div class="col-md-4">
                <strong>Fecha límite:</strong>
                <p class="text-muted">@Model.FechaTexto</p>
            </div>
        </div>

        <hr />

        <div class="row align-items-center">
            <div class="col-md-6">
                <strong>Monto ofrecido:</strong>
                <p class="fs-4 fw-bold text-success mb-0">
                    $@Model.MontoOfrecido.ToString("N0")
                </p>
            </div>

            <div class="col-md-6">
                <strong>Estado del envío:</strong>
                <div class="mt-2">
                    @if (Model.Estado == "Buscando conductor")
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2">
                            Buscando conductor
                        </span>
                    }
                    else if (Model.Estado == "Conductor asignado")
                    {
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2">
                            Conductor asignado
                        </span>
                    }
                    else if (Model.Estado == "Entregado")
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                            Entregado
                        </span>
                    }
                    else if (Model.Estado == "Cancelado")
                    {
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">
                            Cancelado
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary rounded-pill px-3 py-2">
                            @Model.Estado
                        </span>
                    }
                </div>
            </div>
        </div>

    </div>

</div>
