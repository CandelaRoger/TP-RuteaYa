@model RuteaYa.MVC.Models.CrearEnvioViewModel
@{
    ViewData["Title"] = "Nuevo Envío";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <h3 class="fw-bold text-primary mb-1">Nuevo envío</h3>
            <p class="text-muted mb-4">Publicá un paquete que necesitás transportar y encontrá conductores compatibles.</p>

            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4 mb-4" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Origen" class="form-label small text-muted fw-semibold">Origen</label>
                        <input asp-for="Origen" class="form-control form-control-lg bg-light border-0" placeholder="¿Dónde lo retiran? (Ej: Plaza Italia)" />
                        <span asp-validation-for="Origen" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Destino" class="form-label small text-muted fw-semibold">Destino</label>
                        <input asp-for="Destino" class="form-control form-control-lg bg-light border-0" placeholder="¿A dónde llega? (Ej: Obelisco)" />
                        <span asp-validation-for="Destino" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="Fecha" class="form-label small text-muted fw-semibold">Fecha límite</label>
                        <input asp-for="Fecha" type="date" class="form-control bg-light border-0" />
                        <span asp-validation-for="Fecha" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Peso" class="form-label small text-muted fw-semibold">Peso (kg)</label>
                        <input asp-for="Peso" type="number" step="0.5" min="0.1" class="form-control bg-light border-0" />
                        <span asp-validation-for="Peso" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MontoOfrecido" class="form-label small text-muted fw-semibold">Monto ofrecido ($)</label>
                        <input asp-for="MontoOfrecido" type="number" step="100" min="1" class="form-control bg-light border-0" />
                        <span asp-validation-for="MontoOfrecido" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small text-muted fw-semibold d-block">Tamaño del paquete</label>
                    <div class="d-flex gap-2">
                        @{
                            var tamanos = new[] { "Pequeño", "Mediano", "Grande" };
                        }
                        @foreach (var t in tamanos)
                        {
                            <input type="radio" class="btn-check" id="tam_@t" name="Tamanio" value="@t" @(Model.Tamanio == t ? "checked" : "") />
                            <label class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold" for="tam_@t">@t</label>
                        }
                    </div>
                    <span asp-validation-for="Tamanio" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Descripcion" class="form-label small text-muted fw-semibold">Descripción del paquete</label>
                    <input asp-for="Descripcion" class="form-control form-control-lg bg-light border-0" placeholder="Ej: Zapatillas deportivas, documentos, repuestos..." />
                    <span asp-validation-for="Descripcion" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">Cancelar</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Publicar envío</button>
                </div>
            </form>
        </div>
    </div>
</div>