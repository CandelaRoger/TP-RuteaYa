@model RuteaYa.MVC.Models.MisTransportesViewModel

@{
    ViewData["Title"] = "Mis Transportes";
}

<h2 class="fw-bold text-brand mb-2"><i class="bi bi-truck"></i> Mis Transportes</h2>
<p class="text-muted mb-4">Gestión de paquetes que aceptaste llevar.</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Transportes == null || !Model.Transportes.Any())
{
    <div class="alert alert-light border rounded-4 p-4 text-center text-muted">
        <i class="bi bi-box-seam fs-3 d-block mb-2"></i>
        Todavía no tenés paquetes asignados a tus viajes.
    </div>
}
else
{
    <div class="card card-custom bg-white p-0">
        <div class="list-group list-group-flush rounded-4">
            @foreach (var item in Model.Transportes)
            {
                <div class="list-group-item p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">

                    <!-- Información principal -->
                    <div>
                        <h6 class="fw-bold mb-1">
                            @item.Descripcion
                            <span class="fw-normal text-muted">(@item.OrigenDir → @item.DestinoDir)</span>
                        </h6>
                        <p class="text-muted small mb-0">
                            Ganancia: <strong class="text-success">@item.MontoOfrecido.ToString("C0")</strong>
                        </p>
                    </div>

                    <!-- Estado y Acciones -->
                    <div class="d-flex flex-wrap align-items-center gap-2">

                        <!-- Badge dinámico según Estado -->
                        @switch (item.Estado)
                        {
                            case "Conductor asignado":
                                <span class="badge bg-secondary-subtle text-secondary border">
                                    <i class="bi bi-person-check"></i> Conductor asignado
                                </span>
                                break;
                            case "Retirado":
                                <span class="badge bg-info text-dark border">
                                    <i class="bi bi-box-arrow-down"></i> Retirado
                                </span>
                                break;
                            case "En Camino":
                                <span class="badge bg-warning text-dark border">
                                    <i class="bi bi-truck"></i> En Camino
                                </span>
                                break;
                            case "Entregado":
                                <span class="badge bg-success text-white">
                                    <i class="bi bi-check2-all"></i> Entregado
                                </span>
                                break;
                            default:
                                <span class="badge bg-light text-dark border">@item.Estado</span>
                                break;
                        }

                        <!-- Accesos a detalles -->
                        <a asp-controller="Viajes" asp-action="Detalles" asp-route-id="@item.ViajeId"
                           class="btn btn-sm btn-outline-secondary rounded-pill">
                            Ver viaje
                        </a>
                        <a asp-controller="Envios" asp-action="Detalles" asp-route-id="@item.EnvioId"
                           class="btn btn-sm btn-outline-secondary rounded-pill">
                            Ver envío
                        </a>

                        <!-- Único Dropdown respetando transiciones de estado -->
                        @if (item.Estado != "Entregado")
                        {
                            <div class="dropdown">
                                <button class="btn btn-brand btn-sm dropdown-toggle rounded-pill" type="button" data-bs-toggle="dropdown">
                                    Actualizar Estado
                                </button>
                                <ul class="dropdown-menu shadow">
                                    @if (item.Estado == "Conductor asignado")
                                    {
                                        <li>
                                            <form asp-action="CambiarEstado" method="post">
                                                <input type="hidden" name="envioId" value="@item.EnvioId" />
                                                <input type="hidden" name="nuevoEstado" value="Retirado" />
                                                <button type="submit" class="dropdown-item text-info fw-semibold">
                                                    Marcar 'Retirado'
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    @if (item.Estado == "Retirado")
                                    {
                                        <li>
                                            <form asp-action="CambiarEstado" method="post">
                                                <input type="hidden" name="envioId" value="@item.EnvioId" />
                                                <input type="hidden" name="nuevoEstado" value="En Camino" />
                                                <button type="submit" class="dropdown-item text-primary fw-semibold">
                                                    Marcar 'En Camino'
                                                </button>
                                            </form>
                                        </li>
                                    }
                                    @if (item.Estado == "En Camino")
                                    {
                                        <li>
                                            <form asp-action="CambiarEstado" method="post">
                                                <input type="hidden" name="envioId" value="@item.EnvioId" />
                                                <input type="hidden" name="nuevoEstado" value="Entregado" />
                                                <button type="submit" class="dropdown-item text-success fw-semibold">
                                                    Marcar 'Entregado'
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                </div>
            }
        </div>
    </div>
}