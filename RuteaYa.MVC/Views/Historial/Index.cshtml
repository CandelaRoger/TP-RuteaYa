@model RuteaYa.DTOs.HistorialViewModel

@{
    ViewData["Title"] = "Historial";
}

<div class="container py-4">

    <h2 class="fw-bold text-brand mb-4">
        <i class="bi bi-clock-history"></i> Historial de Operaciones
    </h2>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card card-custom bg-white p-3 text-center border-start border-4 border-primary shadow-sm">
                <p class="text-muted small text-uppercase mb-1 fw-bold">
                    Viajes Realizados
                </p>
                <h2 class="fw-bold text-primary mb-0">
                    @Model.TotalViajes
                </h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-custom bg-white p-3 text-center border-start border-4 border-info shadow-sm">
                <p class="text-muted small text-uppercase mb-1 fw-bold">
                    Envíos Transportados
                </p>
                <h2 class="fw-bold text-info mb-0">
                    @Model.TotalEnvios
                </h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card card-custom bg-success text-white p-3 text-center shadow-sm">
                <p class="small text-uppercase mb-1 fw-bold opacity-75">
                    Ganancia Efectiva
                </p>
                <h2 class="fw-bold mb-0">
                    @Model.GananciaTotal.ToString("C")
                </h2>
            </div>
        </div>
    </div>

    <form method="get" asp-controller="Historial" asp-action="Index"
          class="card card-custom bg-white p-3 mb-4 shadow-sm">

        <div class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="form-label small fw-bold">Estado</label>
                <select name="estado" class="form-select">
                    <option value="Todos" selected="@(ViewBag.Estado == "Todos")">
                        Todos
                    </option>
                    <option value="Conductor asignado" selected="@(ViewBag.Estado == "Conductor asignado")">
                        Conductor asignado
                    </option>
                    <option value="Retirado" selected="@(ViewBag.Estado == "Retirado")">
                        Retirado
                    </option>
                    <option value="En Camino" selected="@(ViewBag.Estado == "En Camino")">
                        En camino
                    </option>
                    <option value="Entregado" selected="@(ViewBag.Estado == "Entregado")">
                        Entregado
                    </option>
                    <option value="Cancelado" selected="@(ViewBag.Estado == "Cancelado")">
                        Cancelado
                    </option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold">Desde</label>
                <input type="date"
                       name="fechaInicio"
                       class="form-control"
                       value="@ViewBag.FechaInicio" />
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold">Hasta</label>
                <input type="date"
                       name="fechaFin"
                       class="form-control"
                       value="@ViewBag.FechaFin" />
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-filter"></i> Filtrar
                </button>
            </div>

        </div>

        <div class="mt-2">
            <a asp-controller="Historial"
               asp-action="Index"
               class="btn btn-sm btn-outline-secondary">
                Limpiar filtros
            </a>
        </div>
    </form>

    <div class="card card-custom bg-white p-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-borderless table-striped align-middle mb-0">

                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Operación / Ruta</th>
                        <th>Fecha / Detalle</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Monto</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Operaciones != null && Model.Operaciones.Any())
                    {
                        foreach (var op in Model.Operaciones)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-secondary me-2">
                                        @op.Tipo
                                    </span>
                                    <strong>@op.Ruta</strong>
                                </td>

                                <td>
                                    @if (op.Fecha.HasValue)
                                    {
                                        <div>
                                            @op.Fecha.Value.ToString("dd/MM/yyyy")
                                        </div>
                                    }

                                    <small class="text-muted">
                                        @op.Detalle
                                    </small>
                                </td>

                                <td>
                                    <span class="badge @op.EstadoBadge">
                                        @op.Estado
                                    </span>
                                </td>

                                <td class="text-end pe-4 fw-bold @(op.Estado == "Entregado" ? "text-success" : "text-muted")">
                                    @op.Monto.ToString("C")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No se registran operaciones en el historial.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>
