@model RuteaYa.MVC.Models.CrearViajeViewModel
@{
    ViewData["Title"] = "Nuevo Viaje";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <h3 class="fw-bold text-primary mb-1">Nuevo viaje</h3>
            <p class="text-muted mb-4">Registrá tu recorrido habitual para transportar paquetes y generar ingresos.</p>

            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4 mb-4" role="alert"></div>

                @* Origen y Destino *@
                <div class="row g-3 mb-3">
                   <div class="col-md-6">
              <label asp-for="Origen" class="form-label small text-muted fw-semibold">Origen</label>

                <div class="position-relative">
                  <input asp-for="Origen"
               id="Origen"
               class="form-control form-control-lg bg-light border-0"
               placeholder="Escribí una dirección o lugar..."
               autocomplete="off" />

        <div id="sugerenciasOrigen"
             class="list-group position-absolute w-100 shadow-sm"
             style="z-index: 1000; display: none;">
        </div>
    </div>

    <span asp-validation-for="Origen" class="text-danger small"></span>
</div>
                   <div class="col-md-6">
    <label asp-for="Destino" class="form-label small text-muted fw-semibold">Destino</label>

    <div class="position-relative">
        <input asp-for="Destino"
               id="Destino"
               class="form-control form-control-lg bg-light border-0"
               placeholder="¿A dónde llegás?"
               autocomplete="off" />

        <div id="sugerenciasDestino"
             class="list-group position-absolute w-100 shadow-sm"
             style="z-index: 1000; display: none;">
        </div>
    </div>

    <span asp-validation-for="Destino" class="text-danger small"></span>
</div>
                </div>

                @* Paradas intermedias *@
                <div class="mb-4">
    <label asp-for="ParadasTexto" class="form-label small text-muted fw-semibold">
        Paradas intermedias (opcional)
    </label>

    <div class="position-relative">
        <input asp-for="ParadasTexto"
               id="ParadasTexto"
               class="form-control bg-light border-0"
               placeholder="Escribí una parada y seleccionala..." 
               autocomplete="off" />

        <div id="sugerenciasParadas"
             class="list-group position-absolute w-100 shadow-sm"
             style="z-index: 1000; display: none;">
        </div>
    </div>

    <span class="text-muted small">
        Podés agregar varias paradas, seleccionando cada lugar.
    </span>
</div>
                @* Selector de Días de la semana con botones toggle pill *@
                <div class="mb-4">
                    <label class="form-label small text-muted fw-semibold d-block">Días de la semana que realizás el viaje</label>
                    <div class="d-flex flex-wrap gap-2">
                        @{
                            var dias = new (byte id, string nombre)[] {
                                (1, "Lun"), (2, "Mar"), (3, "Mié"), (4, "Jue"), (5, "Vie"), (6, "Sáb"), (7, "Dom")
                            };
                        }
                        @foreach (var d in dias)
                        {
                            <input type="checkbox" class="btn-check" id="dia_@d.id" name="DiasSeleccionados" value="@d.id" autocomplete="off" />
                            <label class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold" for="dia_@d.id">@d.nombre</label>
                        }
                    </div>
                </div>

                @* Horarios *@
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="HoraSalida" class="form-label small text-muted fw-semibold">Hora de salida</label>
                        <input asp-for="HoraSalida" type="time" class="form-control bg-light border-0" />
                        <span asp-validation-for="HoraSalida" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="HoraLlegada" class="form-label small text-muted fw-semibold">Hora estimada de llegada</label>
                        <input asp-for="HoraLlegada" type="time" class="form-control bg-light border-0" />
                        <span asp-validation-for="HoraLlegada" class="text-danger small"></span>
                    </div>
                </div>

                @* Capacidades y Desvío *@
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="MaxPaquetes" class="form-label small text-muted fw-semibold">Paquetes máximos</label>
                        <input asp-for="MaxPaquetes" type="number" class="form-control bg-light border-0" min="1" />
                        <span asp-validation-for="MaxPaquetes" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PesoMaxKg" class="form-label small text-muted fw-semibold">Peso máximo (kg)</label>
                        <input asp-for="PesoMaxKg" type="number" step="0.5" class="form-control bg-light border-0" min="0.5" />
                        <span asp-validation-for="PesoMaxKg" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DesvioMaxKm" class="form-label small text-muted fw-semibold">Desvío máximo (km)</label>
                        <input asp-for="DesvioMaxKm" type="number" step="0.5" class="form-control bg-light border-0" min="0" />
                        <span asp-validation-for="DesvioMaxKm" class="text-danger small"></span>
                    </div>
                </div>

                @* Botones de Acción *@
                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">Cancelar</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Guardar viaje</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function configurarAutocompletado(campo, contenedor, obtenerTexto, seleccionarLugar) {
            let temporizador;
            let ultimaBusqueda = 0;

            campo.addEventListener("input", function () {
                clearTimeout(temporizador);

                const texto = obtenerTexto().trim();
                const busquedaActual = ++ultimaBusqueda;

                contenedor.innerHTML = "";
                contenedor.style.display = "none";

                if (texto.length < 3)
                    return;

                temporizador = setTimeout(async () => {
                    try {
                        const respuesta = await fetch(
                            `/Viajes/BuscarDirecciones?texto=${encodeURIComponent(texto)}`
                        );

                        if (!respuesta.ok)
                            return;

                        const lugares = await respuesta.json();

                        if (busquedaActual !== ultimaBusqueda ||
                            obtenerTexto().trim() !== texto)
                            return;

                        contenedor.innerHTML = "";

                        lugares.forEach(lugar => {
                            const opcion = document.createElement("button");
                            opcion.type = "button";
                            opcion.className = "list-group-item list-group-item-action";

                            const titulo = document.createElement("strong");
                            titulo.textContent = lugar.titulo;

                            const direccion = document.createElement("small");
                            direccion.className = "d-block text-muted";
                            direccion.textContent = lugar.direccion;

                            opcion.appendChild(titulo);
                            opcion.appendChild(direccion);

                            opcion.addEventListener("click", function () {
                                seleccionarLugar(lugar);
                                contenedor.innerHTML = "";
                                contenedor.style.display = "none";
                            });

                            contenedor.appendChild(opcion);
                        });

                        contenedor.style.display =
                            lugares.length > 0 ? "block" : "none";
                    }
                    catch (error) {
                        console.error("Error al buscar direcciones:", error);
                    }
                }, 350);
            });

            document.addEventListener("click", function (evento) {
                if (!campo.contains(evento.target) &&
                    !contenedor.contains(evento.target)) {
                    contenedor.style.display = "none";
                }
            });
        }

        configurarAutocompletado(
            document.getElementById("Origen"),
            document.getElementById("sugerenciasOrigen"),
            () => document.getElementById("Origen").value,
            lugar => {
                document.getElementById("Origen").value = lugar.direccion;
            }
        );

        configurarAutocompletado(
            document.getElementById("Destino"),
            document.getElementById("sugerenciasDestino"),
            () => document.getElementById("Destino").value,
            lugar => {
                document.getElementById("Destino").value = lugar.direccion;
            }
        );

        configurarAutocompletado(
            document.getElementById("ParadasTexto"),
            document.getElementById("sugerenciasParadas"),
            () => {
                const valor = document.getElementById("ParadasTexto").value;
                return valor.substring(valor.lastIndexOf(",") + 1);
            },
            lugar => {
                const campo = document.getElementById("ParadasTexto");
                const valor = campo.value;
                const ultimaComa = valor.lastIndexOf(",");

                const anteriores = ultimaComa >= 0
                    ? valor.substring(0, ultimaComa + 1) + " "
                    : "";

                campo.value = anteriores + lugar.direccion + ", ";
                campo.focus();
            }
        );
    </script>
}

}
