@model RuteaYa.MVC.Models.CrearViajeViewModel
@{
    ViewData["Title"] = "Nuevo Viaje";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <h3 class="fw-bold text-primary mb-1">Nuevo viaje</h3>
            <p class="text-muted mb-4">Registrá tu recorrido habitual para transportar paquetes y generar ingresos.</p>

            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4 mb-4" role="alert"></div>

                @* Origen y Destino *@
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Origen" class="form-label small text-muted fw-semibold">Origen</label>
                        <input asp-for="Origen" class="form-control form-control-lg bg-light border-0" placeholder="¿Desde dónde salís? (Ej: Belgrano)" />
                        <span asp-validation-for="Origen" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Destino" class="form-label small text-muted fw-semibold">Destino</label>
                        <input asp-for="Destino" class="form-control form-control-lg bg-light border-0" placeholder="¿A dónde llegás? (Ej: Lomas de Zamora)" />
                        <span asp-validation-for="Destino" class="text-danger small"></span>
                    </div>
                </div>

                @* Paradas intermedias *@
                <div class="mb-4">
                    <label asp-for="ParadasTexto" class="form-label small text-muted fw-semibold">Paradas intermedias (opcional)</label>
                    <input asp-for="ParadasTexto" class="form-control bg-light border-0" placeholder="Separadas por coma. Ej: Caballito, Lanús" />
                    <span class="text-muted small">Podés agregar lugares por donde pasás habitualmente.</span>
                </div>

                @* Selector de Días de la semana con botones toggle pill *@
                <div class="mb-4">
                    <label class="form-label small text-muted fw-semibold d-block">Días de la semana que realizás el viaje</label>
                    <div class="d-flex flex-wrap gap-2">
                        @{
                            var dias = new (byte id, string nombre)[] {
                                (1, "Lun"), (2, "Mar"), (3, "Mié"), (4, "Jue"), (5, "Vie"), (6, "Sáb"), (7, "Dom")
                            };
                        }
                        @foreach (var d in dias)
                        {
                            <input type="checkbox" class="btn-check" id="dia_@d.id" name="DiasSeleccionados" value="@d.id" autocomplete="off" />
                            <label class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold" for="dia_@d.id">@d.nombre</label>
                        }
                    </div>
                </div>

                @* Horarios *@
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="HoraSalida" class="form-label small text-muted fw-semibold">Hora de salida</label>
                        <input asp-for="HoraSalida" type="time" class="form-control bg-light border-0" />
                        <span asp-validation-for="HoraSalida" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="HoraLlegada" class="form-label small text-muted fw-semibold">Hora estimada de llegada</label>
                        <input asp-for="HoraLlegada" type="time" class="form-control bg-light border-0" />
                        <span asp-validation-for="HoraLlegada" class="text-danger small"></span>
                    </div>
                </div>

                @* Capacidades y Desvío *@
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="MaxPaquetes" class="form-label small text-muted fw-semibold">Paquetes máximos</label>
                        <input asp-for="MaxPaquetes" type="number" class="form-control bg-light border-0" min="1" />
                        <span asp-validation-for="MaxPaquetes" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PesoMaxKg" class="form-label small text-muted fw-semibold">Peso máximo (kg)</label>
                        <input asp-for="PesoMaxKg" type="number" step="0.5" class="form-control bg-light border-0" min="0.5" />
                        <span asp-validation-for="PesoMaxKg" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DesvioMaxKm" class="form-label small text-muted fw-semibold">Desvío máximo (km)</label>
                        <input asp-for="DesvioMaxKm" type="number" step="0.5" class="form-control bg-light border-0" min="0" />
                        <span asp-validation-for="DesvioMaxKm" class="text-danger small"></span>
                    </div>
                </div>

                @* Botones de Acción *@
                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">Cancelar</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold shadow-sm">Guardar viaje</button>
                </div>
            </form>
        </div>
    </div>
</div>